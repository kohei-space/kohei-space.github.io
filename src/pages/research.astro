---
import Layout from '../layouts/Layout.astro';
import ShowcaseItem from '../components/ShowcaseItem.astro';
import { research } from '../data/research';
import { ui } from '../i18n/ui';
import { bi } from '../i18n/bi';

// 最初に書き出される文言は日本語(英語は、言語切り替えで差し替わります)
const jp = ui.ja;

const headingClass = 'text-2xl font-bold text-gray-900 mb-8 pl-4 border-l-4 border-blue-600';
---

<Layout title="Research">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20">
    <div class="max-w-3xl mx-auto text-center mb-16">
      <h1 class="text-4xl font-bold text-gray-900 mb-4" data-i18n-key="research.title">{jp['research.title']}</h1>
      <p class="text-lg text-gray-600" {...bi(research.intro)}>{research.intro.ja}</p>
    </div>

    {research.projects.length > 0 && (
      <section id="projects" class="mb-20 scroll-mt-24">
        <h2 class={headingClass} data-i18n-key="research.projects">{jp['research.projects']}</h2>
        <div class="space-y-12">
          {research.projects.map((item, i) => <ShowcaseItem {...item} index={i} />)}
        </div>
      </section>
    )}

    {research.facilities.length > 0 && (
      <section id="facilities" class="mb-8 scroll-mt-24">
        <h2 class={headingClass} data-i18n-key="research.facilities">{jp['research.facilities']}</h2>
        <div class="space-y-12">
          {research.facilities.map((item, i) => <ShowcaseItem {...item} index={i} />)}
        </div>
      </section>
    )}
  </div>
</Layout>
