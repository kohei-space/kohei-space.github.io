---
import Layout from '../../layouts/Layout.astro';
import { ArrowLeft } from 'lucide-react';
import { news } from '../../data/news';
import { ui } from '../../i18n/ui';
import { bi } from '../../i18n/bi';

// ニュース1件ごとの詳細ページを作ります(URL は /news/<slug>)
export function getStaticPaths() {
  return news.map(item => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

// 最初に書き出される文言は日本語(英語は、言語切り替えで差し替わります)
const jp = ui.ja;
const { item } = Astro.props;
---

<Layout title={item.title.en}>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20">
    <a href="/news" class="inline-flex items-center gap-1 text-sm font-medium text-blue-600 hover:text-blue-700 mb-8 group">
      <ArrowLeft className="w-4 h-4 group-hover:-translate-x-1 transition-transform" />
      <span data-i18n-key="news.back">{jp['news.back']}</span>
    </a>

    <time class="block text-sm text-gray-500 mb-2" datetime={item.date}>{item.date}</time>
    <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-8" {...bi(item.title)}>{item.title.ja}</h1>

    {item.image && (
      <img src={item.image} alt={item.title.en} class="w-full rounded-xl border border-gray-100 shadow-sm mb-8" />
    )}

    <div class="space-y-4 text-gray-700 leading-relaxed">
      {item.body.map(paragraph => <p {...bi(paragraph)}>{paragraph.ja}</p>)}
    </div>
  </article>
</Layout>
